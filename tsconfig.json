{
  "compilerOptions": {
    "target": "ES5", // 微信小程序支持 ES5+
    "module": "ESNext", // 使用 CommonJS 模块系统（小程序支持）
    "lib": ["ES2015", "dom", "es2018"], // 支持 Promise、Map 等
    "declaration": true, // 生成 .d.ts 类型声明文件
    // 输出到本仓库的 dist，避免意外写到其他工程
    "outDir": "./dist",
    // 声明文件输出目录（rollup/typescript 插件会使用此值）
    "declarationDir": "./dist",
    "rootDir": "./src", // 源码目录
    "strict": true, // 开启所有严格类型检查
    "esModuleInterop": true, // 支持默认导入（import xxx from 'xxx'）
    "moduleResolution": "node", // 模块解析策略为 Node
    "skipLibCheck": true, // 忽略第三方类型检查，提高速度
    "types": ["miniprogram-api-typings"], // 引入微信小程序 API 类型定义
    "baseUrl": ".", // 设置根路径
    "paths": {
      "@utils/*": ["src/utils/*"] // 设置路径别名（根据需要调整）
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
